#!/usr/bin/env bash
# Launcher for the IBKR Analytics .app bundle.
# Opens Terminal.app and runs start.sh from the project directory.

# Bundle now lives in bin/; repo root is four levels up from this script
# (bin/IBKR Analytics.app/Contents/MacOS/ -> repo root).
PROJECT_DIR="$(cd "$(dirname "$0")/../../../.." && pwd)"

osascript -e "
tell application \"Terminal\"
    activate
    do script \"cd '$PROJECT_DIR' && ./bin/start.sh\"
end tell
"
